# Copy to .env and adjust. Never commit the real .env file.

# --- MariaDB (used by docker-compose.yml AND by the Node scripts) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=wiki_time_machine
DB_USER=wtm_app
DB_PASSWORD=change-me-app-password
# Only used by docker-compose to initialise the container (never by the application).
DB_ROOT_PASSWORD=change-me-root-password

# Optional SELECT-only account used by the web server (least privilege). Created by
# db/init/00-create-databases.sh when DB_WEB_PASSWORD is non-empty. If unset, the web
# server falls back to DB_USER.
DB_WEB_USER=wtm_web
DB_WEB_PASSWORD=change-me-web-password

# Separate database used by the integration tests (created by db/init/00-create-databases.sh).
DB_TEST_NAME=wiki_time_machine_test

# --- Web application ---
PORT=3000
LOG_LEVEL=info
# Requests per minute per IP for the expensive endpoints (as-of, diff).
RATE_LIMIT_PER_MINUTE=120

# --- Wikipedia API etiquette ---
# Wikimedia asks API clients to send a User-Agent with contact information.
# Override if you fork the project (URL or e-mail of the person running the ingestion).
# WIKI_USER_AGENT_CONTACT=https://github.com/your-name/your-fork

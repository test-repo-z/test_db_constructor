<%- include('partials/head') %>
<p class="small"><a href="/articles/<%= article.article_id %>">← <%= article.canonical_title %></a></p>
<h1>Revision history — <%= article.canonical_title %></h1>
<form class="inline card" method="get">
  <label>Valid from (UTC)<input type="datetime-local" name="from" step="1" min="<%= inputValue(coverage.startIso) %>" max="<%= inputValue(coverage.endIso) %>" value="<%= inputValue(from.iso) %>"></label>
  <label>to (UTC)<input type="datetime-local" name="to" step="1" min="<%= inputValue(coverage.startIso) %>" max="<%= inputValue(coverage.endIso) %>" value="<%= inputValue(to.iso) %>"></label>
  <button type="submit">Filter</button>
</form>
<p class="small secondary"><%= fmtNum(total) %> revisions whose <span class="tag app">valid time</span> overlaps the range (<code>valid_from ≤ to AND valid_to &gt; from</code>), newest first.</p>
<div class="table-wrap card"><table>
  <thead><tr><th>Revision</th><th>Valid from (= saved)</th><th>Valid until</th><th>Editor</th><th class="num">Size</th><th>Comment</th></tr></thead>
  <tbody>
  <% for (const r of revisions) { %>
    <tr>
      <td class="mono"><a href="/articles/<%= article.article_id %>/as-of?t=<%= r.valid_from_iso %>"><%= r.rev_id %></a><% if (r.is_baseline) { %> <span class="tag">baseline</span><% } %></td>
      <td class="mono"><%= r.valid_from %></td>
      <td class="mono"><%= r.open_ended ? '∞' : r.valid_to %></td>
      <td><%= r.editor_hidden ? '(hidden)' : (r.editor ?? '—') %></td>
      <td class="num"><%= fmtNum(r.size_bytes) %></td>
      <td class="small"><%= r.comment_hidden ? '(hidden)' : (r.comment || '') %></td>
    </tr>
  <% } %>
  </tbody>
</table></div>
<div class="pagination">
  <% if (page > 1) { %><a href="?<%= q({ from: from.iso, to: to.iso, page: page - 1 }) %>">← newer</a><% } %>
  <span class="muted small">page <%= page %> / <%= pages %></span>
  <% if (page < pages) { %><a href="?<%= q({ from: from.iso, to: to.iso, page: page + 1 }) %>">older →</a><% } %>
</div>
<%- include('partials/foot') %>
